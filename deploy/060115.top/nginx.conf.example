server {
    listen 80;
    server_name 060115.top www.060115.top;
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }

    # 应用本身也会校验 HELPDESK_ADMIN_*；网关层再加一层 Basic Auth。
    location ~ ^/(backend|admin)(/|$) { auth_basic "Helpdesk Admin"; auth_basic_user_file /etc/nginx/.htpasswd-helpdesk; proxy_pass http://127.0.0.1:8787; include proxy_params; }
    location ~ ^/api/(tickets|backend|rag|audit)(/|$) { auth_basic "Helpdesk Admin"; auth_basic_user_file /etc/nginx/.htpasswd-helpdesk; proxy_pass http://127.0.0.1:8787; include proxy_params; }
}
