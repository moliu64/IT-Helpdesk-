# Copy this file to .env and fill in your own key.
LLM_PROVIDER=deepseek
LLM_WEBSITE=https://www.deepseek.com
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.1
LLM_VISION_MODEL=DeepSeek-V4-Flash-Vision-Exp
LLM_API_KEY=replace_with_your_deepseek_key

# Enable these only after the BGE model is available in the local cache.
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1

# RAG warmup policy: background = load the local BGE/Chroma index in a daemon
# thread right after startup (fast first search, instant /healthz); 1 = load
# synchronously before serving; 0 = never prewarm (first query pays ~6s cold
# start). Default is background.
# HELPDESK_RAG_PREWARM=background

# Managed RAG knowledge store: editable knowledge entries (per document) shown
# on the /rag admin page. Optional overrides are mainly useful for tests so a
# test server never mutates the real store or Chroma index.
# HELPDESK_RAG_STORE=data/knowledge/managed_entries.json
# HELPDESK_RAG_INDEX_DIR=data/tickets/index
# HELPDESK_RAG_SOURCE_ROOT=.

# Web server: use 0.0.0.0 only when running behind a trusted HTTPS gateway.
HELPDESK_HOST=127.0.0.1
HELPDESK_PORT=8787
HELPDESK_ADMIN_USER=admin
HELPDESK_ADMIN_PASSWORD=replace_with_a_long_random_password
HELPDESK_SESSION_SECRET=replace_with_a_long_random_session_secret
# Admin login cookie lifetime in days (rotating the password invalidates it).
HELPDESK_ADMIN_SESSION_DAYS=30
# 1 = always mark cookies Secure. Leave unset/0: the admin login cookie is
# marked Secure automatically when X-Forwarded-Proto: https is present.
HELPDESK_COOKIE_SECURE=0

# Optional Windows online deployment settings.
# HELPDESK_PUBLIC_URL=https://060115.top
# HELPDESK_ONLINE_PORT=8787
# HELPDESK_TUNNEL_CONFIG=deploy/060115.top/cloudflared-local-config.yml
# CLOUDFLARED_PATH=C:\\Users\\YOUR_NAME\\.cloudflared\\cloudflared.exe
# cloudflared is auto-discovered (PATH, %USERPROFILE%\.cloudflared, Program Files,
# WinGet). When none is found, the launcher downloads it into
# %USERPROFILE%\.cloudflared\cloudflared.exe; set CLOUDFLARED_PATH only for a
# custom location or to disable that download in offline environments.
