# Copy this file to .env and fill in your own key.
LLM_PROVIDER=deepseek
LLM_WEBSITE=https://www.deepseek.com
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_TEMPERATURE=0.1
LLM_API_KEY=replace_with_your_deepseek_key

# The BGE model is expected to be available in the local cache.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
